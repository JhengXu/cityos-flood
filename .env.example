# CITY OS · 环境变量模板（复制为 .env 并填入真实值；.env 已 gitignore）
# 真实凭据见 docs/access_credentials.md，请勿提交 .env 到公开仓库

# 深圳市政府数据开放平台（下载需登录会话；JSESSIONID 有有效期，失效需重新登录获取）
SZ_OPENDATA_JSESSIONID=your_jsessionid_here
SZ_OPENDATA_ARIAAPPID=your_ariaappid_here

# 天地图 API（浏览器端 key，调用需 Referer: https://lbs.tianditu.gov.cn/）
TIANDITU_KEY=your_tianditu_key_here

# （可选）真实数据目录环境变量：ml/realdata.py 用它定位深圳开放平台 P0 数据
SHENZHEN_P0_DATA=
